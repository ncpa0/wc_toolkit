{
  "name": "wc_toolkit",
  "version": "0.1.2",
  "main": "./dist/legacy/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/legacy/index.js"
    },
    "./styles.css": {
      "default": "./styles.css"
    }
  },
  "keywords": [
    "web component",
    "web components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ncpa0/wc_toolkit"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README"
  ],
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Szymon Bretner (ncpa0cpl)",
    "email": "szymonb21@gmail.com"
  },
  "scripts": {
    "test:tsc": "tsc --noEmit",
    "test:unit": "vitest run",
    "bench": "node ./bench/bench.mjs",
    "bench:browser": "node ./bench/browser/run.mjs",
    "prepare": "husky install",
    "build": "node ./scripts/build.mjs",
    "fix:lint": "oxlint --fix ./src",
    "test:lint": "oxlint ./src",
    "fix:fmt": "dprint fmt",
    "test:fmt": "dprint check",
    "postinstall": "if [ -f \".postinstall\" ]; then patch-package; fi",
    "prepack": "yarn build --clean"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@ncpa0cpl/nodepack": "^2.3.3",
    "dprint": "^0.47.2",
    "esbuild": "^0.23.1",
    "git-hook-tasks": "git+https://github.com/ncpa0cpl/git-hook-tasks#0.0.1",
    "happy-dom": "^15.7.3",
    "husky": "~8",
    "oxlint": "^0.9.3",
    "patch-package": "^8.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
